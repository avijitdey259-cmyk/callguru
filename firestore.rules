// PiCall — Firestore Security Rules (প্রজেক্ট picall-76185)।
// ডিপ্লয় করা হয়নি — Firestore কনসোলে চালু হওয়ার পর এই কমান্ডে ডিপ্লয় হবে:
//   firebase deploy --only firestore:rules --project picall-76185
// (firebase.json-এ "firestore": { "rules": "firestore.rules" } বসানো আছে।)
//
// নিয়মের সারকথা:
//   users/{uid}   — শুধু সেই ব্যবহারকারীই নিজের ডক পড়তে/লিখতে পারেন
//                    (request.auth.uid == uid); অ্যাডমিন শুধু আপডেট করতে পারেন
//                    (KYC অনুমোদন/বাতিলের জন্য — তৈরি/মুছে ফেলা নয়)।
//   publicProfiles/{uid} — নতুন সদস্য: শুধু displayName + createdAt + colour
//                    (ইমেইল/ফোন/আইডি/KYC/ব্যালেন্স এখানে নেই); লগইন করা সবাই
//                    পড়তে পারেন, লিখতে পারেন শুধু সেই ব্যবহারকারী নিজে;
//                    অ্যাডমিন শুধু displayName/colour বদলাতে পারেন (নাম এডিট)।
//                    ⚠️ নিয়ম কনসোলে publish না হওয়া পর্যন্ত অ্যাডমিন-এডিট ব্যর্থ হবে।
//   config/public — লগইন করা সবাই পড়তে পারেন (দর + পেমেন্টের বিবরণ);
//                    লিখতে পারেন শুধু অ্যাডমিন (avijitdey259@gmail.com)।
//   topups/{id}   — ব্যবহারকারী শুধু নিজের আবেদন তৈরি/পড়তে পারেন;
//                    অ্যাডমিন সব পড়তে ও স্ট্যাটাস বদলাতে পারেন।
//   chats/{roomId}/messages/{msgId} — রুমের নামে দুই UID থাকে
//                    (ছোট UID আগে, '_' দিয়ে জোড়া); শুধু ওই দুই
//                    ব্যবহারকারীই পড়তে/লিখতে পারেন; লেখার সময়
//                    fromUid নিজের UID-ই হতে হবে। আপডেট/মোছা বন্ধ।
//   services/{serviceId} — ভার্চুয়াল (শুধু ভিডিও কল) সার্ভিস: লগইন করা
//                    সবাই পড়তে পারেন; তৈরি/বদলাতে পারেন শুধু মালিক নিজে
//                    (providerUid নিজের UID); মোছা বন্ধ।
//   services/{serviceId}/reviews/{reviewId} — রিভিউ: লগইন করা সবাই
//                    পড়তে পারেন (নামসহ); লিখতে পারেন শুধু রিভিউয়ার নিজে।
//   ads/{adId}     — ব্যবহারকারীর পণ্যের বিজ্ঞাপন: লগইন করা সবাই পড়তে
//                    পারেন; জমা দিতে পারেন শুধু মালিক নিজে (ownerUid নিজের
//                    UID, স্ট্যাটাস সবসময় pending); অনুমোদন/বাতিল শুধু
//                    অ্যাডমিন। Adsterra-র সাথে এর কোনো সম্পর্ক নেই।
//   groups/{groupId} — গ্রুপ: লগইন করা সবাই পড়তে পারেন; তৈরি করতে পারেন
//                    শুধু মালিক নিজে (ownerUid নিজের UID, নিজেই প্রথম
//                    সদস্য); পাবলিক গ্রুপে যে কেউ যোগ দিতে/ছাড়তে পারেন
//                    (memberUids-এ শুধু নিজের UID যোগ/বাদ); সদস্য যোগ/বাদ
//                    শুধু মালিক; বাকি বদল শুধু মালিক/অ্যাডমিন। মোছা বন্ধ।
//   groups/{groupId}/posts/{postId} — গ্রুপের পোস্ট: পড়া সবার; লেখা শুধু
//                    সদস্যের (authorUid নিজের UID)।
//   pages/{pageId}  — পেজ: লগইন করা সবাই পড়তে পারেন; তৈরি করতে পারেন শুধু
//                    মালিক নিজে; যে কেউ ফলো/আনফলো করতে পারেন (followerUids-এ
//                    শুধু নিজের UID যোগ/বাদ); বাকি বদল শুধু মালিক/অ্যাডমিন।
//   pages/{pageId}/posts/{postId} — পেজের পোস্ট: পড়া সবার; লেখা শুধু
//                    পেজের মালিকের।
//   বাকি সব — ডিফল্টভাবে বন্ধ।
// NID/সেলফি/ভিডিও Firestore-এ কখনো যায় না (কোডেই বাদ দেওয়া হয়), তাই নিয়মে
// সেগুলোর আলাদা কিছু লেখার দরকার নেই — ক্লাউডে সেগুলো থাকার কথাই নয়।
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'avijitdey259@gmail.com';
    }

    // এক ব্যবহারকারীর ব্যক্তিগত ডেটা — শুধু সেই ব্যবহারকারী + অ্যাডমিন (আপডেট only)।
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin();
    }

    // নতুন সদস্যের পাবলিক প্রোফাইল — শুধু নাম + যোগদানের সময় + রং।
    // ব্যক্তিগত ডেটা (users/{uid}) খোলা হয়নি — এই কালেকশনেই শুধু পাবলিক ক্ষেত্র থাকে।
    // অ্যাডমিন নাম বদলাতে পারেন, তবে শুধু displayName/colour — অন্য ক্ষেত্র নয়।
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'colour']);
      allow delete: if false;
    }

    // সবার জন্য অ্যাডমিনের দর + পেমেন্টের বিবরণ — পড়া সবার, লেখা শুধু অ্যাডমিনের।
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ম্যানুয়াল টপ-আপ আবেদন — নিজেরটা তৈরি/পড়া; অ্যাডমিন সব পড়া + স্ট্যাটাস বদলানো।
    match /topups/{topupId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // চ্যাট রুমের সূচক ডক (chats/{roomId}) — প্রাপক যেন রুমটা খুঁজে পায়
    // (শুধু messages সাবকালেকশনে লিখলে প্রাপক রুমের অস্তিত্বই জানত না)।
    // পড়া/লেখা শুধু রুমের দুই সদস্যের; members-এ নিজের UID থাকতে হবে।
    match /chats/{roomId} {
      allow read: if isSignedIn() && (request.auth.uid == roomId.split('_')[0] || request.auth.uid == roomId.split('_')[1]);
      allow create, update: if isSignedIn() && (request.auth.uid == roomId.split('_')[0] || request.auth.uid == roomId.split('_')[1])
        && request.auth.uid in request.resource.data.members;
      allow delete: if false;
    }

    // আসল বন্ধুর চ্যাট — রুমের নামে দুই UID থাকে (ছোট UID আগে, '_' দিয়ে
    // জোড়া); শুধু ওই দুই ব্যবহারকারীই পড়তে/লিখতে পারেন; লেখার সময়
    // fromUid নিজের UID-ই হতে হবে। আপডেট/মোছা বন্ধ।
    match /chats/{roomId}/messages/{msgId} {
      allow read: if isSignedIn() && (request.auth.uid == roomId.split('_')[0] || request.auth.uid == roomId.split('_')[1]);
      allow create: if isSignedIn() && (request.auth.uid == roomId.split('_')[0] || request.auth.uid == roomId.split('_')[1])
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ভার্চুয়াল (শুধু ভিডিও কল) সার্ভিস — সব সার্ভিস ভিডিও কলে হয়, কখনো
    // সামনাসামনি নয়; তাই location / in-person ক্ষেত্র এখানে নেই। লগইন করা
    // সবাই পড়তে পারেন; তৈরি/বদলাতে পারেন শুধু সেই সার্ভিসের মালিক নিজে
    // (providerUid নিজের UID-ই হতে হবে); মোছা বন্ধ।
    // ⚠️ এই নিয়মগুলো Firebase কনসোলে publish না হওয়া পর্যন্ত অন্য ডিভাইস
    // থেকে সার্ভিস/রিভিউ পড়া-লেখা যাবে না (local cache-ই শুধু দেখাবে):
    //   firebase deploy --only firestore:rules --project picall-76185
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.providerUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.providerUid == request.auth.uid;
      allow delete: if false;
    }

    // সার্ভিসের রিভিউ — লগইন করা সবাই পড়তে পারেন, রিভিউয়ারের নামসহ
    // (মালিকের শর্ত: রিভিউ কে দিয়েছেন তা সবাই দেখতে পাবেন)। লিখতে পারেন
    // শুধু রিভিউয়ার নিজে (reviewerUid নিজের UID-ই হতে হবে); বদলানো/মোছা বন্ধ।
    match /services/{serviceId}/reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reviewerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ব্যবহারকারীর পণ্যের বিজ্ঞাপন — জমা দেন মালিক নিজে (স্ট্যাটাস pending),
    // অনুমোদন/বাতিল শুধু অ্যাডমিন। ফিডে শুধু approved দেখায়। View/click
    // গণনা: লগইন করা যে কেউ একবারে শুধু একটা কাউন্টার ঠিক ১ বাড়াতে পারেন
    // (views+1 বা clicks+1) — নিজের ইচ্ছেমতো সংখ্যা বসানো যায় না।
    match /ads/{adId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'clicks'])
          && ((request.resource.data.views == resource.data.views + 1 && request.resource.data.clicks == resource.data.clicks)
            || (request.resource.data.clicks == resource.data.clicks + 1 && request.resource.data.views == resource.data.views)));
      allow delete: if false;
    }

    // গ্রুপ — তৈরি করেন মালিক নিজে (নিজেই প্রথম সদস্য); পাবলিক গ্রুপে যে
    // কেউ যোগ দিতে/ছাড়তে পারেন (memberUids-এ শুধু নিজের UID যোগ/বাদ)।
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || (isSignedIn() && resource.data.visibility == 'public'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && ((request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.auth.uid in request.resource.data.memberUids)
          || (resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && !(request.auth.uid in request.resource.data.memberUids))));
      allow delete: if false;
    }

    // গ্রুপের পোস্ট — পড়তে পারেন লগইন করা সবাই; লিখতে পারেন শুধু ওই গ্রুপের
    // সদস্য নিজে (authorUid নিজের UID, parent গ্রুপের memberUids-এ থাকতে হবে)।
    // লিংকের নিয়ম টেক্সটে ধরা যায় না — নিয়মে শুধু সদস্য + লেখার আকার ধরা
    // হয়; অন্য চ্যাট অ্যাপের লিংক অ্যাপেই (submit-এ) আটকানো হয়।
    match /groups/{groupId}/posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }

    // পেজ — তৈরি করেন মালিক নিজে; যে কেউ ফলো/আনফলো করতে পারেন
    // (followerUids-এ শুধু নিজের UID যোগ/বাদ)।
    match /pages/{pageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerUids'])
          && ((request.resource.data.followerUids.hasAll(resource.data.followerUids)
            && request.resource.data.followerUids.size() == resource.data.followerUids.size() + 1
            && request.auth.uid in request.resource.data.followerUids)
          || (resource.data.followerUids.hasAll(request.resource.data.followerUids)
            && request.resource.data.followerUids.size() == resource.data.followerUids.size() - 1
            && !(request.auth.uid in request.resource.data.followerUids))));
      allow delete: if false;
    }

    // পেজের পোস্ট — পড়তে পারেন লগইন করা সবাই; লিখতে পারেন শুধু পেজের
    // মালিক নিজে (parent পেজের ownerUid নিজের UID হতে হবে)।
    match /pages/{pageId}/posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && get(/databases/$(database)/documents/pages/$(pageId)).data.ownerUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }

    // বাকি সব ডিফল্টভাবে বন্ধ।
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
